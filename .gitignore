# --------------------------------------------------
#   Filetypes and keys
# --------------------------------------------------
*.pid
*.xml
*.csr
*.crt
*.key

# --------------------------------------------------
#   Home Assistant runtime database & logs
# --------------------------------------------------
home-assistant.log
home-assistant.log.*
home-assistant_v2.db
home-assistant_v2.db-wal
home-assistant_v2.db-shm

# --------------------------------------------------
#   HA Core runtime files (should never be committed)
# --------------------------------------------------
.core/
.storage/
.cloud/
.config/
deps/
tts/
camera/
www/
glances/
blueprints/
custom_components/
/media/

core

# HA Backup files
*.old
*.tmp

# --------------------------------------------------
#   Python cache
# --------------------------------------------------
__pycache__/
*.pyc

# --------------------------------------------------
#   Local configs that should not be in version control
# --------------------------------------------------
secrets.yaml
known_devices.yaml
Deepstack.txt
IKEA Gateway.txt
packages/car.yaml
todo.txt
ip_bans.yaml
frigate/config.yaml

# --------------------------------------------------
#   Archive and temporary files with sensitive data
# --------------------------------------------------
esphome/archive/
*_not_used
*.temp_not_used

# --------------------------------------------------
#   Generic excludes
# --------------------------------------------------
.uuid
*.db
*.db-shm
*.db-wal
*.bak

# --------------------------------------------------
#   Hidden files EXCEPT .gitignore
# --------------------------------------------------
.*
!/.gitignore
