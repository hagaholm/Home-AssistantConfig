
automation:
  - alias: Download image
    trigger:
      platform: time_pattern
      minutes: /1

    action:
      - service: downloader.download_file
        data_template:
          filename: 'helags_{{now().strftime("%Y%m%d_%H%M")}}.jpg'
          overwrite: true
          subdir: helags
          url: "http://www.meac.se/helags.jpg"
